# 复制成 .env 后按需修改。.env 已在 .gitignore 里,不会提交。

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops_dev_pw
POSTGRES_DB=ops_assistant
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka ----
# KAFKA_PORT 是 docker-compose 拼端口映射用的裸端口号;
# KAFKA_BOOTSTRAP_SERVERS 是给 backend-service / llm-service 连接用的完整地址。
# 两个要一起改,只改一个会导致 docker-compose 和两个服务用的端口对不上。
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DOC_UPLOAD_TOPIC=document-upload-events

# ---- LLM / Embedding (Day 10 起用到) ----
# OpenAI 或兼容接口;也可以后面换成本地 sentence-transformers,那样这几项留空
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# ---- 上传文件存放目录(backend 写,llm-service 读)----
# 相对路径是相对【各服务自己的目录】解析的:backend-service/ 和 llm-service/ 是兄弟目录,
# ../uploads 对两边都指向仓库根的 uploads/。要用绝对路径也行,两边必须指向同一个目录。
UPLOAD_DIR=../uploads

# ---- 服务端口 ----
BACKEND_PORT=8081
LLM_SERVICE_PORT=8000

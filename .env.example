# 复制成 .env 后按需修改。.env 已在 .gitignore 里,不会提交。

# ---- PostgreSQL ----
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops_dev_pw
POSTGRES_DB=ops_assistant
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_PORT=9092

# ---- LLM / Embedding (Day 10 起用到) ----
# OpenAI 或兼容接口;也可以后面换成本地 sentence-transformers,那样这几项留空
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# ---- 服务端口 ----
BACKEND_PORT=8081
LLM_SERVICE_PORT=8000

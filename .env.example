# Copy to .env and adjust. .env is in .gitignore and never committed.

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_USER=ops
# Set your own password before the first start. Note: Postgres uses this value to create the user
# only when the data volume is created for the FIRST time; changing it later doesn't change the
# password in the database (run ALTER USER inside the container, or recreate with down -v).
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ops_assistant
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka ----
# KAFKA_PORT is the bare port docker compose uses for the port mapping;
# KAFKA_BOOTSTRAP_SERVERS is the full address backend-service / llm-service connect to.
# Change both together; changing only one leaves docker compose and the services on different ports.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DOC_UPLOAD_TOPIC=document-upload-events

# ---- LLM / embeddings (document embedding and Q&A) ----
# OpenAI or a compatible API; with local sentence-transformers later, leave these empty
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-6-luna

# ---- document consumer ----
# Optional. The consumer's group; the backend reads the same value to look up its lag
# DOC_CONSUMER_GROUP=llm-service-document-ingest

# ---- query path ----
# Shared secret: llm-service trusts the role and department it is sent only from a caller holding this.
# llm-service refuses to start without it, and the backend answers /query with 503. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=
LLM_SERVICE_URL=http://localhost:8000
# Processes of llm-service (default 1). One reaches about 100 QPS, so production sets 4
# LLM_SERVICE_WORKERS=4
# Model calls at once per llm-service process (default 300). Tests against the real API are paid for privately, so a
# low value is fine in development; it says nothing about production
# MODEL_MAX_CONCURRENT_CALLS=5
# Questions per second per backend instance, above which they get 429 (default 300)
# QUERY_RATE_LIMIT_QPS=300
# Keep this on localhost unless a firewall or private network keeps everyone but the backend away from the port
LLM_SERVICE_HOST=127.0.0.1
# The reranker (docker compose --profile rerank up -d reranker), default http://127.0.0.1:8082. Empty: no reranking.
# When it is down or slower than RERANK_TIMEOUT_SECONDS (default 0.5), a query keeps the vector order and logs a
# warning; on a development CPU it is always slower. Production points this at a GPU instance
# RERANKER_URL=

# ---- upload folder (backend writes, llm-service reads) ----
# A relative path resolves against EACH SERVICE'S OWN FOLDER: backend-service/ and llm-service/ are
# siblings, so ../uploads points at uploads/ at the repository root for both. An absolute path works
# too; both sides must point at the same folder.
UPLOAD_DIR=../uploads

# ---- service ports ----
BACKEND_PORT=8081
LLM_SERVICE_PORT=8000
